{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User account document containing game save and profile",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "gameState": { "type": "object" },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "description": "Multi-turn Gemini chat messages with history and assistant role",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string" },
        "agentRole": { "type": "string" },
        "modelUsed": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "UserProfile"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "entity": "ChatMessage"
    }
  }
}
